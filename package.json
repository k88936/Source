{
    "name": "source",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vite dev --host 0.0.0.0",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier --write .",
        "bindings": "cargo test -p source-core -p source-jobs && pnpm exec prettier --write 'src/lib/api/bindings/*.ts'",
        "tauri": "tauri",
        "demo:dev": "vite dev --config vite.config.demo.ts",
        "demo:build": "vite build --config vite.config.demo.ts",
        "site:dev": "vite dev --config site/vite.config.ts",
        "site:build": "vite build --config site/vite.config.ts",
        "site:preview": "vite preview --config site/vite.config.ts"
    },
    "dependencies": {
        "@immich/ui": "0.91.1",
        "@lucide/svelte": "1.68.0",
        "@saurl/tauri-plugin-safe-area-insets-css-api": "0.1.0",
        "@tauri-apps/api": "^2.9.0",
        "@tauri-apps/plugin-log": "~2.10.1",
        "@tauri-apps/plugin-opener": "^2.5.0",
        "svelte": "5.57.3"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "4.0.0",
        "@sveltejs/kit": "3.1.0",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@tailwindcss/vite": "4.3.3",
        "@tauri-apps/cli": "^2.9.0",
        "@types/node": "^26.6.5",
        "devices.css": "^0.2.0",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "svelte-check": "^4.7.5",
        "tailwindcss": "4.3.3",
        "typescript": "~5.9.3",
        "vite": "8.3.5"
    }
}
